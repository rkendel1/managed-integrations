# Copy to .env (`make env` does this and generates a key). Never commit .env.
# Credential encryption keyring: comma-separated keyId:base64(32 bytes); first is primary.
#   generate: openssl rand -base64 32
CREDENTIAL_ENCRYPTION_KEYS=k1:REPLACE_WITH_BASE64_32_BYTES
POSTGRES_PASSWORD=mi_dev_password
API_PORT=3000
PUBLIC_BASE_URL=http://localhost:3000

# Shopify app credentials (Partner/Dev Dashboard). Defaults target the deterministic fixture.
SHOPIFY_CLIENT_ID=fixture-shopify-client-id
SHOPIFY_CLIENT_SECRET=fixture-shopify-client-secret
# Demo only — route provider calls to the fixtures. Must be empty in production.
SHOPIFY_BASE_URL_OVERRIDE=http://fixtures:4010
NETSUITE_BASE_URL_OVERRIDE=http://fixtures:4020
DEMO_FIXTURES=true

# Seeded logins (required in production, >= 12 chars)
SEED_CUSTOMER_PASSWORD=
SEED_OPERATOR_PASSWORD=
# Production only
SESSION_SECRET=
MI_DOMAIN=

# Maintenance agent: playbook | claude | auto (auto = playbook, then Claude if a key is set)
MAINTENANCE_PLANNER=auto
ANTHROPIC_API_KEY=

# Image overrides (e.g. a registry mirror if Docker Hub rate-limits you)
# NODE_IMAGE=mirror.gcr.io/library/node:22-bookworm-slim
# POSTGRES_IMAGE=mirror.gcr.io/library/postgres:16-alpine
# DOCKER_CLI_IMAGE=mirror.gcr.io/library/docker:29-cli
# SANDBOX_NODE_IMAGE=mirror.gcr.io/library/node:22-bookworm-slim
# SANDBOX_POSTGRES_IMAGE=mirror.gcr.io/library/postgres:16-alpine
SYNC_INTERVAL_MINUTES=1

# Builds behind a TLS-intercepting proxy (optional)
# EXTRA_CA_FILE=/path/to/ca-bundle.crt
# BUILD_NETWORK=host
# BUILD_HTTPS_PROXY=http://proxy:port
